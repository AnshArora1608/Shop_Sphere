<%- include("../partials/adminSidebar", { active: "dashboard" }) %>
<%- include("../partials/adminTopbar") %>

<style>
:root{
--ink:#12131c;
--line:#e7e8f0;
--text:#1b1d29;
--muted:#6b7280;
--accent:#6d5bd0;
--accent-2:#f2a93b;
--teal:#14b8a6;
--green:#16a34a;
--red:#dc2626;
}

.ss-main{
margin-left:264px;
padding:100px 32px 40px;
min-height:100vh;
width:calc(100% - 264px);
box-sizing:border-box;
}

.ss-page-head{
display:flex;
justify-content:space-between;
align-items:flex-end;
flex-wrap:wrap;
gap:14px;
margin-bottom:28px;
}

.ss-page-head h2{
font-family:'Plus Jakarta Sans',sans-serif;
font-weight:700;
font-size:26px;
margin:0 0 5px;
}

.ss-page-head p{
color:var(--muted);
font-size:14px;
margin:0;
}

.ss-date-chip{
background:#fff;
border:1px solid var(--line);
border-radius:10px;
padding:8px 14px;
font-size:13px;
font-weight:600;
display:flex;
align-items:center;
gap:8px;
}

.ss-date-chip i{
color:var(--accent);
}

.stat-strip{
display:grid;
grid-template-columns:repeat(4,1fr);
background:#fff;
border:1px solid var(--line);
border-radius:16px;
overflow:hidden;
}

.stat-cell{
position:relative;
display:flex;
align-items:center;
gap:14px;
padding:22px;
min-width:0;
}

.stat-cell + .stat-cell{
border-left:1px solid var(--line);
}

.stat-cell:after{
content:"";
position:absolute;
left:0;
top:20%;
bottom:20%;
width:3px;
border-radius:0 3px 3px 0;
background:var(--dot,var(--accent));
}

.stat-icon{
width:42px;
height:42px;
border-radius:11px;
display:flex;
align-items:center;
justify-content:center;
color:#fff;
font-size:18px;
flex-shrink:0;
}

.stat-label{
color:var(--muted);
font-size:12px;
font-weight:600;
letter-spacing:.05em;
text-transform:uppercase;
}

.stat-value{
font-family:'JetBrains Mono',monospace;
font-size:22px;
font-weight:600;
color:var(--text);
}

.qa-title{
font-size:16px;
font-weight:700;
margin:32px 0 16px;
}

.qa-strip{
display:grid;
grid-template-columns:repeat(4,1fr);
background:#fff;
border:1px solid var(--line);
border-radius:16px;
overflow:hidden;
}

.qa-tile{
display:flex;
align-items:center;
gap:12px;
padding:18px 20px;
text-decoration:none;
color:var(--text);
font-size:14px;
font-weight:600;
transition:.2s;
}

.qa-tile+.qa-tile{
border-left:1px solid var(--line);
}

.qa-tile:hover{
background:#fafafd;
color:var(--text);
}

.qa-icon{
width:38px;
height:38px;
border-radius:10px;
display:flex;
align-items:center;
justify-content:center;
color:#fff;
font-size:17px;
flex-shrink:0;
}

.panel{
background:#fff;
border:1px solid var(--line);
border-radius:16px;
margin-top:38px;
overflow:hidden;
}

.panel-head{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 24px;
border-bottom:1px solid var(--line);
}

.panel-head h4{
margin:0;
font-size:16px;
font-weight:700;
}

.panel-head a{
color:var(--accent);
text-decoration:none;
font-size:13px;
font-weight:600;
}

.ss-table{
width:100%;
border-collapse:collapse;
}

.ss-table thead th{
padding:12px 24px;
background:#fafafd;
border-bottom:1px solid var(--line);
font-size:12px;
color:var(--muted);
text-transform:uppercase;
}

.ss-table tbody td{
padding:14px 24px;
border-bottom:1px solid var(--line);
font-size:14px;
}

.ss-table tbody tr:hover{
background:#fafafd;
}

.row-user{
display:flex;
align-items:center;
gap:10px;
}

.avatar-chip{
width:32px;
height:32px;
border-radius:50%;
background:var(--accent);
color:#fff;
display:flex;
align-items:center;
justify-content:center;
font-size:12px;
font-weight:700;
}

.amount-cell{
font-family:'JetBrains Mono',monospace;
font-weight:600;
}

.status-pill{
display:inline-flex;
align-items:center;
gap:6px;
padding:5px 12px;
border-radius:20px;
font-size:12px;
font-weight:700;
}

.status-pill:before{
content:"";
width:6px;
height:6px;
border-radius:50%;
background:currentColor;
}

.status-delivered{
background:#ecfdf5;
color:#16a34a;
}

.status-shipped{
background:#eef2ff;
color:#6d5bd0;
}

.status-pending{
background:#fffbeb;
color:#b45309;
}

.status-cancelled{
background:#fef2f2;
color:#dc2626;
}

.status-default{
background:#f3f4f6;
color:#6b7280;
}

.ss-empty{
padding:50px 20px;
text-align:center;
color:var(--muted);
}

.ss-empty i{
font-size:35px;
display:block;
margin-bottom:10px;
}

@media(max-width:991px){

.ss-main{
margin-left:76px;
width:calc(100% - 76px);
padding:95px 20px 30px;
}

.stat-strip{
grid-template-columns:repeat(2,1fr);
}

.qa-strip{
grid-template-columns:repeat(2,1fr);
}

}

@media(max-width:576px){

.ss-main{
margin-left:0;
width:100%;
padding:90px 15px 25px;
}

.stat-strip{
grid-template-columns:1fr;
}

.qa-strip{
grid-template-columns:1fr;
}

.stat-cell+.stat-cell{
border-left:none;
border-top:1px solid var(--line);
}

.qa-tile+.qa-tile{
border-left:none;
border-top:1px solid var(--line);
}

.ss-page-head h2{
font-size:22px;
}

.panel{
overflow-x:auto;
}

.ss-table{
min-width:600px;
}

}
</style>

<div class="ss-main">

    <div class="ss-page-head">

        <div>
            <h2>Dashboard</h2>
            <p>Welcome back — here's what's happening across your store.</p>
        </div>

        <div class="ss-date-chip">
            <i class="bi bi-calendar3"></i>
            <span id="ss-today"></span>
        </div>

    </div>

    <!-- Stats -->
    <div class="stat-strip">

        <div class="stat-cell" style="--dot:#6d5bd0;">
            <div class="stat-icon" style="background:#6d5bd0;"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="stat-label">Total Products</div>
                <div class="stat-value"><%= totalProducts %></div>
            </div>
        </div>

        <div class="stat-cell" style="--dot:#14b8a6;">
            <div class="stat-icon" style="background:#14b8a6;"><i class="bi bi-people"></i></div>
            <div>
                <div class="stat-label">Total Users</div>
                <div class="stat-value"><%= totalUsers %></div>
            </div>
        </div>

        <div class="stat-cell" style="--dot:#f2a93b;">
            <div class="stat-icon" style="background:#f2a93b;"><i class="bi bi-cart-check"></i></div>
            <div>
                <div class="stat-label">Total Orders</div>
                <div class="stat-value"><%= totalOrders %></div>
            </div>
        </div>

        <div class="stat-cell" style="--dot:#16a34a;">
            <div class="stat-icon" style="background:#16a34a;"><i class="bi bi-currency-rupee"></i></div>
            <div>
                <div class="stat-label">Revenue</div>
                <div class="stat-value">₹<%= revenue %></div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="qa-title">Quick actions</div>

    <div class="qa-strip">

        <a href="/admin/product/add" class="qa-tile">
            <div class="qa-icon" style="--tile-color:#6d5bd0;"><i class="bi bi-plus-circle"></i></div>
            Add Product
        </a>

        <a href="/admin/products" class="qa-tile">
            <div class="qa-icon" style="--tile-color:#12131c;"><i class="bi bi-box-seam"></i></div>
            Manage Products
        </a>

        <a href="/admin/orders" class="qa-tile">
            <div class="qa-icon" style="--tile-color:#16a34a;"><i class="bi bi-cart-check"></i></div>
            Orders
        </a>

        <a href="/admin/users" class="qa-tile">
            <div class="qa-icon" style="--tile-color:#f2a93b;"><i class="bi bi-people"></i></div>
            Users
        </a>

    </div>

    <!-- Recent Orders -->
    <div class="panel">

        <div class="panel-head">
            <h4>Recent Orders</h4>
            <a href="/admin/orders">View all <i class="bi bi-arrow-right"></i></a>
        </div>

        <% if (typeof orders !== "undefined" && orders.length > 0) { %>

        <table class="ss-table">

            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Total</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                <% orders.slice(0,5).forEach(order => {
                    const custName = order.user ? order.user.name : "Unknown";
                    const initials = custName.split(" ").filter(Boolean).slice(0,2).map(n => n[0].toUpperCase()).join("") || "?";
                    const statusRaw = (order.status || "").toLowerCase();
                    let statusClass = "status-default";
                    if (statusRaw === "delivered") statusClass = "status-delivered";
                    else if (statusRaw === "shipped") statusClass = "status-shipped";
                    else if (statusRaw === "pending") statusClass = "status-pending";
                    else if (statusRaw === "cancelled" || statusRaw === "canceled") statusClass = "status-cancelled";
                %>

                <tr>
                    <td>
                        <div class="row-user">
                            <div class="avatar-chip"><%= initials %></div>
                            <span><%= custName %></span>
                        </div>
                    </td>
                    <td class="amount-cell">₹<%= order.totalPrice %></td>
                    <td>
                        <span class="status-pill <%= statusClass %>"><%= order.status %></span>
                    </td>
                </tr>

                <% }) %>

            </tbody>

        </table>

        <% } else { %>

        <div class="ss-empty">
            <i class="bi bi-inbox"></i>
            No orders yet — new orders will show up here as they come in.
        </div>

        <% } %>
    </div>

</div>

<script>
document.getElementById("ss-today").textContent = new Date().toLocaleDateString(undefined, { weekday: "long", year: "numeric", month: "long", day: "numeric" });
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
