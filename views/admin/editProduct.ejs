<%- include("../partials/adminSidebar", { active: "products" }) %>
<%- include("../partials/adminTopbar") %>

<style>

:root{
    --ink:#12131c;
    --line:#e7e8f0;
    --text:#1b1d29;
    --muted:#6b7280;
    --accent:#6d5bd0;
    --accent-2:#f2a93b;
}

body{ background:#f4f5fa; }
.ss-main{
margin-left:264px;
padding:100px 32px 40px;
min-height:100vh;
width:calc(100% - 264px);
box-sizing:border-box;
}


@media(max-width:991px){

.ss-main{
margin-left:76px;
width:calc(100% - 76px);
padding:90px 20px 30px;
}

}


.ss-page-head{ display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:14px; margin-bottom:26px; }

.ss-page-head h2{
    font-family:'Plus Jakarta Sans',sans-serif;
    font-weight:700;
    font-size:26px;
    letter-spacing:-.01em;
    margin-bottom:4px;
}

.ss-page-head p{ color:var(--muted); font-size:14.5px; margin:0; }

.back-link{
    display:inline-flex;
    align-items:center;
    gap:6px;
    color:var(--muted);
    text-decoration:none;
    font-size:13.5px;
    font-weight:600;
    margin-bottom:14px;
}

.back-link:hover{ color:var(--text); }

.form-grid{
    display:grid;
    grid-template-columns:1fr 320px;
    gap:24px;
    align-items:start;
}

.panel{
    background:#fff;
    border:1px solid var(--line);
    border-radius:16px;
    padding:28px;
}

.field-row{ display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px; }

.field{ margin-bottom:20px; }

.field label{ display:block; font-size:13px; font-weight:700; color:var(--text); margin-bottom:7px; }

.field .hint{ font-weight:500; color:var(--muted); font-size:12px; margin-left:6px; }

.field input[type="text"],
.field input[type="number"],
.field select,
.field textarea{
    width:100%;
    border:1px solid var(--line);
    border-radius:10px;
    padding:11px 14px;
    font-size:14.5px;
    font-family:'Inter',sans-serif;
    background:#fafafd;
    outline:none;
    transition:border-color .15s ease, background .15s ease;
}

.field input:focus,
.field select:focus,
.field textarea:focus{ border-color:var(--accent); background:#fff; }

.field textarea{ min-height:120px; resize:vertical; }

.price-prefix{ position:relative; }

.price-prefix span{
    position:absolute;
    left:14px;
    top:50%;
    transform:translateY(-50%);
    color:var(--muted);
    font-weight:600;
    font-size:14.5px;
}

.price-prefix input{ padding-left:30px !important; }

.side-note{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:700; font-size:15px; margin-bottom:14px; }

.current-thumb{
    width:100%;
    height:200px;
    object-fit:cover;
    border-radius:12px;
    border:1px solid var(--line);
    margin-bottom:14px;
}

.upload-zone{
    border:2px dashed var(--line);
    border-radius:14px;
    padding:18px;
    text-align:center;
    cursor:pointer;
    transition:border-color .15s ease, background .15s ease;
    position:relative;
    overflow:hidden;
    display:block;
}

.upload-zone:hover{ border-color:var(--accent); background:#faf9ff; }

.upload-zone i{ font-size:22px; color:var(--accent); }

.upload-zone p{ margin:6px 0 0; font-size:13px; color:var(--muted); }

.upload-zone input[type="file"]{ position:absolute; inset:0; opacity:0; cursor:pointer; }

.preview-wrap{ margin-top:12px; display:none; }

.preview-wrap img{ width:100%; height:160px; object-fit:cover; border-radius:12px; border:1px solid var(--line); }

.preview-wrap .file-name{ margin-top:8px; font-size:12.5px; color:var(--muted); word-break:break-all; }

.form-actions{ display:flex; justify-content:flex-end; gap:12px; margin-top:8px; }

.btn-ghost{
    border:1px solid var(--line);
    background:#fff;
    color:var(--text);
    font-weight:600;
    font-size:14.5px;
    padding:11px 20px;
    border-radius:10px;
    text-decoration:none;
}

.btn-ghost:hover{ background:#fafafd; color:var(--text); }

.btn-submit{
    border:none;
    background:#16a34a;
    color:#fff;
    font-weight:700;
    font-size:14.5px;
    padding:11px 24px;
    border-radius:10px;
    cursor:pointer;
    transition:background .15s ease;
}

.btn-submit:hover{ background:#128a3e; }

@media(max-width:900px){
    .form-grid{ grid-template-columns:1fr; }
    .field-row{ grid-template-columns:1fr; }
}

</style>

<div class="ss-main">

    <a href="/admin/products" class="back-link"><i class="bi bi-arrow-left"></i> Back to products</a>

    <div class="ss-page-head">
        <h2>Edit Product</h2>
        <p>Update the details for <strong><%= product.title %></strong>.</p>
    </div>

    <form action="/admin/product/edit/<%= product._id %>" method="POST" enctype="multipart/form-data">

        <div class="form-grid">

            <div class="panel">

                <div class="field">
                    <label>Product title</label>
                    <input type="text" name="title" value="<%= product.title %>" required>
                </div>

                <div class="field">
                    <label>Description</label>
                    <textarea name="description" required><%= product.description %></textarea>
                </div>

                <div class="field-row">

                    <div class="field">
                        <label>Price <span class="hint">in INR</span></label>
                        <div class="price-prefix">
                            <span>₹</span>
                            <input type="number" name="price" value="<%= product.price %>" min="0" step="0.01" required>
                        </div>
                    </div>

                    <div class="field">
                        <label>Stock quantity</label>
                        <input type="number" name="stock" value="<%= product.stock %>" min="0" required>
                    </div>

                </div>

                <div class="field" style="margin-bottom:0;">
                    <label>Category</label>
                    <select name="category" required>
                        <option value="Electronics" <%= product.category === "Electronics" ? "selected" : "" %>>Electronics</option>
                        <option value="Fashion" <%= product.category === "Fashion" ? "selected" : "" %>>Fashion</option>
                        <option value="Shoes" <%= product.category === "Shoes" ? "selected" : "" %>>Shoes</option>
                        <option value="Accessories" <%= product.category === "Accessories" ? "selected" : "" %>>Accessories</option>
                        <option value="Books" <%= product.category === "Books" ? "selected" : "" %>>Books</option>
                    </select>
                </div>

            </div>

            <div class="panel">

                <div class="side-note">Product image</div>

                <img src="<%= product.imageURL %>" class="current-thumb" alt="<%= product.title %>">

                <label class="upload-zone" id="uploadZone">
                    <i class="bi bi-cloud-arrow-up"></i>
                    <p>Click to replace image<br>Leave empty to keep the current one</p>
                    <input type="file" name="image" accept="image/*" id="imageInput">
                </label>

                <div class="preview-wrap" id="previewWrap">
                    <img id="previewImg" src="" alt="New image preview">
                    <div class="file-name" id="fileName"></div>
                </div>

            </div>

        </div>

        <div class="form-actions">
            <a href="/admin/products" class="btn-ghost">Cancel</a>
            <button type="submit" class="btn-submit">
                <i class="bi bi-check-circle"></i> Update Product
            </button>
        </div>

    </form>

</div>

<script>
const imageInput = document.getElementById("imageInput");
const previewWrap = document.getElementById("previewWrap");
const previewImg = document.getElementById("previewImg");
const fileName = document.getElementById("fileName");

imageInput.addEventListener("change", () => {
    const file = imageInput.files && imageInput.files[0];
    if (!file) {
        previewWrap.style.display = "none";
        return;
    }
    const reader = new FileReader();
    reader.onload = (e) => {
        previewImg.src = e.target.result;
        fileName.textContent = file.name;
        previewWrap.style.display = "block";
    };
    reader.readAsDataURL(file);
});
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
