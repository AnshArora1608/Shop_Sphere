<%- include("../partials/adminSidebar", { active: "products" }) %>
<%- include("../partials/adminTopbar") %>

<style>

:root{
    --ink:#12131c;
    --line:#e7e8f0;
    --text:#1b1d29;
    --muted:#6b7280;
    --accent:#6d5bd0;
    --accent-2:#f2a93b;
    --green:#16a34a;
    --red:#dc2626;
}

body{ background:#f4f5fa; }

.ss-page-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:14px;
    margin-bottom:22px;
}

.ss-page-head h2{
    font-family:'Plus Jakarta Sans',sans-serif;
    font-weight:700;
    font-size:26px;
    letter-spacing:-.01em;
    margin-bottom:4px;
}

.ss-page-head p{ color:var(--muted); font-size:14.5px; margin:0; }

.btn-accent{
    display:inline-flex;
    align-items:center;
    gap:8px;
    background:var(--accent);
    color:#fff;
    border:none;
    border-radius:10px;
    padding:11px 18px;
    font-weight:700;
    font-size:14.5px;
    text-decoration:none;
    transition:background .15s ease, transform .15s ease;
}

.btn-accent:hover{ background:#5c4cc2; color:#fff; transform:translateY(-1px); }

.search-panel{
    background:#fff;
    border:1px solid var(--line);
    border-radius:16px;
    padding:16px 18px;
    margin-bottom:22px;
}

.search-row{ display:flex; gap:12px; }

.search-row input{
    flex:1;
    border:1px solid var(--line);
    border-radius:10px;
    padding:11px 16px;
    font-size:14px;
    outline:none;
    background:#fafafd;
    transition:border-color .15s ease, background .15s ease;
}

.search-row input:focus{ border-color:var(--accent); background:#fff; }

.search-row button{
    border:none;
    border-radius:10px;
    padding:11px 22px;
    font-weight:700;
    font-size:14px;
    color:#fff;
    background:var(--ink);
    cursor:pointer;
    transition:background .15s ease;
}

.search-row button:hover{ background:#22243a; }

.panel{
    background:#fff;
    border:1px solid var(--line);
    border-radius:16px;
    overflow:hidden;
}

.ss-table{ width:100%; border-collapse:collapse; }

.ss-table thead th{
    text-align:left;
    font-size:12px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--muted);
    padding:14px 22px;
    background:#fafafd;
    border-bottom:1px solid var(--line);
}

.ss-table tbody td{
    padding:12px 22px;
    font-size:14.5px;
    border-bottom:1px solid var(--line);
    vertical-align:middle;
}

.ss-table tbody tr:last-child td{ border-bottom:none; }
.ss-table tbody tr:hover{ background:#fafafd; }

.product-thumb{
    width:56px;
    height:56px;
    object-fit:cover;
    border-radius:11px;
    border:1px solid var(--line);
}

.product-title{ font-weight:600; color:var(--text); }

.cat-pill{
    display:inline-block;
    padding:5px 12px;
    border-radius:20px;
    font-size:12.5px;
    font-weight:600;
    background:#f0eefb;
    color:var(--accent);
}

.price-cell{ font-family:'JetBrains Mono',monospace; font-weight:700; color:var(--text); }

.stock-pill{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:5px 12px;
    border-radius:20px;
    font-size:12.5px;
    font-weight:700;
}

.stock-pill::before{ content:""; width:6px; height:6px; border-radius:50%; background:currentColor; }

.stock-in{ background:#ecfdf5; color:var(--green); }
.stock-out{ background:#fef2f2; color:var(--red); }

.action-btns{ display:flex; gap:8px; }

.icon-btn{
    display:inline-flex;
    align-items:center;
    gap:6px;
    border:1px solid var(--line);
    border-radius:9px;
    padding:8px 12px;
    font-size:13px;
    font-weight:600;
    text-decoration:none;
    background:#fff;
    cursor:pointer;
    transition:background .15s ease, border-color .15s ease;
}
.ss-main{
margin-left:264px;
padding:100px 32px 40px;
min-height:100vh;
width:calc(100% - 264px);
box-sizing:border-box;
}


@media(max-width:991px){

.ss-main{
margin-left:76px;
width:calc(100% - 76px);
padding:90px 20px 30px;
}

}

.icon-btn.edit{ color:#b45309; }
.icon-btn.edit:hover{ background:#fffbeb; border-color:#fbbf24; }

.icon-btn.delete{ color:var(--red); }
.icon-btn.delete:hover{ background:#fef2f2; border-color:#fca5a5; }

.ss-empty{ padding:64px 24px; text-align:center; color:var(--muted); }
.ss-empty i{ font-size:36px; color:var(--line); margin-bottom:12px; display:block; }
.ss-empty h4{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:700; font-size:17px; color:var(--text); margin-bottom:6px; }

</style>

<div class="ss-main">

    <div class="ss-page-head">

        <div>
            <h2>Products</h2>
            <p>Manage all products in your store.</p>
        </div>

        <a href="/admin/product/add" class="btn-accent">
            <i class="bi bi-plus-circle"></i>
            Add Product
        </a>

    </div>

    <div class="search-panel">

        <form action="/admin/products" method="GET">

            <div class="search-row">

                <input type="text" name="q" placeholder="Search product by title or category">

                <button type="submit">
                    <i class="bi bi-search"></i>
                    Search
                </button>

            </div>

        </form>

    </div>

    <% if (products.length === 0) { %>

        <div class="panel">
            <div class="ss-empty">
                <i class="bi bi-box-seam"></i>
                <h4>No products found</h4>
                Try a different search, or add your first product.
            </div>
        </div>

    <% } else { %>

    <div class="panel">

        <div class="table-responsive">

            <table class="ss-table">

                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th width="200">Actions</th>
                    </tr>
                </thead>

                <tbody>

                <% products.forEach(product => { %>

                    <tr>

                        <td><img src="<%= product.imageURL %>" class="product-thumb" alt="<%= product.title %>"></td>

                        <td><span class="product-title"><%= product.title %></span></td>

                        <td><span class="cat-pill"><%= product.category %></span></td>

                        <td class="price-cell">₹<%= product.price %></td>

                        <td>

                            <% if (product.stock > 0) { %>
                                <span class="stock-pill stock-in"><%= product.stock %> in stock</span>
                            <% } else { %>
                                <span class="stock-pill stock-out">Out of stock</span>
                            <% } %>

                        </td>

                        <td>

                            <div class="action-btns">

                                <a href="/admin/products/edit/<%= product._id %>" class="icon-btn edit">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>

                                <form action="/admin/products/delete/<%= product._id %>" method="POST">
                                    <button type="submit" onclick="return confirm('Delete this product?')" class="icon-btn delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>

                            </div>

                        </td>

                    </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
