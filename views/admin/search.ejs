<%- include("../partials/adminSidebar", { active: "search" }) %>
<%- include("../partials/adminTopbar") %>


<style>

.ss-main{
    margin-left:264px;
    padding:100px 32px 40px;
    width:calc(100% - 264px);
    box-sizing:border-box;
}


.panel{

    background:#fff;
    border:1px solid #e7e8f0;
    border-radius:16px;
    margin-bottom:25px;
    overflow:hidden;

}


.panel-head{

    padding:18px 24px;
    border-bottom:1px solid #e7e8f0;

}


.panel-head h4{

    margin:0;
    font-size:16px;
    font-weight:700;

}


.ss-table{

    width:100%;
    border-collapse:collapse;

}


.ss-table th{

    background:#fafafd;
    padding:12px 20px;
    color:#6b7280;
    font-size:12px;
    text-transform:uppercase;

}


.ss-table td{

    padding:14px 20px;
    border-top:1px solid #e7e8f0;
    font-size:14px;

}


.ss-table tbody tr:hover{

    background:#fafafd;

}



.avatar{

    width:35px;
    height:35px;
    background:#6d5bd0;
    color:white;
    border-radius:50%;
    display:inline-flex;
    justify-content:center;
    align-items:center;
    font-weight:700;
    margin-right:8px;

}



.product-img{

    width:45px;
    height:45px;
    object-fit:contain;
    border:1px solid #e7e8f0;
    border-radius:8px;

}



.price{

    font-family:'JetBrains Mono',monospace;
    font-weight:600;

}



.status-pill{

    background:#eef2ff;
    color:#6d5bd0;
    padding:5px 12px;
    border-radius:20px;
    font-size:12px;
    font-weight:700;

}



.empty{

    padding:40px;
    text-align:center;
    color:#6b7280;

}


.empty i{

    font-size:35px;
    display:block;
    margin-bottom:10px;

}



@media(max-width:991px){

.ss-main{

    margin-left:76px;
    width:calc(100% - 76px);

}

}



@media(max-width:576px){

.ss-main{

    margin-left:0;
    width:100%;
    padding:90px 15px;

}


.panel{

    overflow-x:auto;

}


.ss-table{

    min-width:600px;

}

}


</style>



<div class="ss-main">


<div class="ss-page-head">

<h2>
Search Results
</h2>


<p>
Showing results for:
<b><%= query || "" %></b>
</p>


</div>



<!-- USERS SECTION -->


<div class="panel">


<div class="panel-head">

<h4>
Users
</h4>

</div>



<% if(users && users.length){ %>


<table class="ss-table">


<thead>

<tr>

<th>User</th>
<th>Email</th>
<th>Role</th>

</tr>

</thead>


<tbody>



<% users.forEach(user=>{ %>


<tr>


<td>


<span class="avatar">

<%= user.name ? user.name[0].toUpperCase() : "?" %>

</span>


<%= user.name %>


</td>



<td>

<%= user.email %>

</td>


<td>

<%= user.role || "User" %>

</td>


</tr>


<% }) %>


</tbody>


</table>


<% }else{ %>


<div class="empty">

<i class="bi bi-people"></i>

No users found

</div>


<% } %>


</div>
<!-- PRODUCTS SECTION -->


<div class="panel">


<div class="panel-head">

<h4>
Products
</h4>

</div>



<% if(products && products.length){ %>


<table class="ss-table">


<thead>

<tr>

<th>Image</th>
<th>Name</th>
<th>Category</th>
<th>Price</th>
<th>Stock</th>

</tr>

</thead>



<tbody>



<% products.forEach(product=>{ %>


<tr>


<td>

<img 
src="<%= product.imageURL %>"
class="product-img"
alt="product"
>

</td>



<td>

<%= product.title %>

</td>



<td>

<%= product.category %>

</td>



<td class="price">

₹<%= product.price %>

</td>



<td>


<span class="status-pill">

<%= product.stock %>

</span>


</td>



</tr>


<% }) %>



</tbody>


</table>



<% }else{ %>



<div class="empty">

<i class="bi bi-box-seam"></i>

No products found

</div>



<% } %>



</div>




</div>




<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>


</body>

</html>