<%- include("../partials/adminSidebar", { active: "users" }) %>
<%- include("../partials/adminTopbar") %>

<style>

:root{
    --ink:#12131c;
    --line:#e7e8f0;
    --text:#1b1d29;
    --muted:#6b7280;
    --accent:#6d5bd0;
    --accent-2:#f2a93b;
    --red:#dc2626;
}

body{ background:#f4f5fa; }

.ss-page-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:14px;
    margin-bottom:26px;
}

.ss-page-head h2{
    font-family:'Plus Jakarta Sans',sans-serif;
    font-weight:700;
    font-size:26px;
    letter-spacing:-.01em;
    margin-bottom:4px;
}

.ss-page-head p{ color:var(--muted); font-size:14.5px; margin:0; }

.ss-chip{
    font-size:13px;
    font-weight:700;
    color:var(--accent);
    background:#f0eefb;
    border-radius:10px;
    padding:9px 16px;
}

.panel{
    background:#fff;
    border:1px solid var(--line);
    border-radius:16px;
    overflow:hidden;
}

.ss-table{ width:100%; border-collapse:collapse; }

.ss-table thead th{
    text-align:left;
    font-size:12px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--muted);
    padding:14px 22px;
    background:#fafafd;
    border-bottom:1px solid var(--line);
}

.ss-table tbody td{
    padding:14px 22px;
    font-size:14.5px;
    border-bottom:1px solid var(--line);
    vertical-align:middle;
}

.ss-table tbody tr:last-child td{ border-bottom:none; }
.ss-table tbody tr:hover{ background:#fafafd; }

.row-index{ color:var(--muted); font-family:'JetBrains Mono',monospace; font-weight:600; font-size:13px; }

.row-user{ display:flex; align-items:center; gap:12px; }

.avatar-chip{
    width:38px;
    height:38px;
    border-radius:50%;
    background:var(--accent);
    color:#fff;
    font-size:14px;
    font-weight:700;
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Plus Jakarta Sans',sans-serif;
    flex-shrink:0;
}

.user-name{ font-weight:600; color:var(--text); }

.role-pill{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:5px 12px;
    border-radius:20px;
    font-size:12.5px;
    font-weight:700;
}

.role-pill::before{ content:""; width:6px; height:6px; border-radius:50%; background:currentColor; }

.role-admin{ background:#fef2f2; color:var(--red); }
.role-user{ background:#ecfdf5; color:#16a34a; }

.date-cell{ color:var(--muted); font-size:13.5px; white-space:nowrap; }

.btn-delete{
    border:1px solid var(--line);
    background:#fff;
    color:var(--red);
    font-weight:600;
    font-size:13px;
    padding:8px 14px;
    border-radius:9px;
    cursor:pointer;
    display:inline-flex;
    align-items:center;
    gap:6px;
    transition:background .15s ease, border-color .15s ease;
}

.btn-delete:hover{ background:#fef2f2; border-color:#fca5a5; }

.btn-protected{
    border:1px solid var(--line);
    background:#fafafd;
    color:var(--muted);
    font-weight:600;
    font-size:13px;
    padding:8px 14px;
    border-radius:9px;
    display:inline-flex;
    align-items:center;
    gap:6px;
    cursor:not-allowed;
}

.ss-empty{ padding:64px 24px; text-align:center; color:var(--muted); }
.ss-empty i{ font-size:36px; color:var(--line); margin-bottom:12px; display:block; }
.ss-empty h4{ font-family:'Plus Jakarta Sans',sans-serif; font-weight:700; font-size:17px; color:var(--text); margin-bottom:6px; }
.ss-main{
margin-left:264px;
padding:100px 32px 40px;
min-height:100vh;
width:calc(100% - 264px);
box-sizing:border-box;
}


@media(max-width:991px){

.ss-main{
margin-left:76px;
width:calc(100% - 76px);
padding:90px 20px 30px;
}

}

</style>

<div class="ss-main">

    <div class="ss-page-head">

        <div>
            <h2>Manage Users</h2>
            <p>View and manage registered users.</p>
        </div>

        <span class="ss-chip">Total Users: <%= users.length %></span>

    </div>

    <% if (users.length === 0) { %>

        <div class="panel">
            <div class="ss-empty">
                <i class="bi bi-people"></i>
                <h4>No users found</h4>
                Registered customers and admins will show up here.
            </div>
        </div>

    <% } else { %>

    <div class="panel">

        <div class="table-responsive">

            <table class="ss-table">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Joined</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                <% users.forEach((user, index) => { %>

                    <tr>

                        <td class="row-index"><%= index + 1 %></td>

                        <td>
                            <div class="row-user">
                                <div class="avatar-chip"><%= user.name.charAt(0).toUpperCase() %></div>
                                <span class="user-name"><%= user.name %></span>
                            </div>
                        </td>

                        <td><%= user.email %></td>

                        <td>

                            <% if (user.role === "ADMIN") { %>
                                <span class="role-pill role-admin">Admin</span>
                            <% } else { %>
                                <span class="role-pill role-user">User</span>
                            <% } %>

                        </td>

                        <td class="date-cell"><%= user.createdAt.toDateString() %></td>

                        <td>

                            <% if (user.role !== "ADMIN") { %>

                                <form action="/admin/user/delete/<%= user._id %>" method="POST" onsubmit="return confirm('Delete this user?')">
                                    <button type="submit" class="btn-delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </form>

                            <% } else { %>

                                <button class="btn-protected" disabled>
                                    <i class="bi bi-shield-lock"></i> Protected
                                </button>

                            <% } %>

                        </td>

                    </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
