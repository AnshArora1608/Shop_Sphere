<%- include("./partials/header") %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="d-flex align-items-baseline justify-content-between mb-4">
    <h2 class="section-title">Checkout</h2>
</div>

<div class="row g-4">

    <div class="col-lg-7">

        <div class="checkout-card mb-4">

            <h4 class="card-heading">Delivery address</h4>

            <form action="/orders/place-order" method="POST" id="checkoutForm">

                <input type="hidden" name="productId" value="<%= product._id %>">

                <div class="row g-3">

                    <div class="col-12 col-sm-6">
                        <input
                            class="form-control app-input"
                            type="tel"
                            name="phone"
                            placeholder="Phone number"
                            pattern="[0-9]{10}"
                            maxlength="10"
                            required>
                    </div>

                    <div class="col-12 col-sm-6">
                        <input
                            class="form-control app-input"
                            type="text"
                            name="pincode"
                            placeholder="Pincode"
                            required>
                    </div>

                    <div class="col-12">
                        <input
                            class="form-control app-input"
                            type="text"
                            name="address"
                            placeholder="House no / street address"
                            required>
                    </div>

                    <div class="col-12 col-sm-6">
                        <input
                            class="form-control app-input"
                            type="text"
                            name="city"
                            placeholder="City"
                            required>
                    </div>

                    <div class="col-12 col-sm-6">
                        <input
                            class="form-control app-input"
                            type="text"
                            name="state"
                            placeholder="State"
                            required>
                    </div>

                </div>

                <h4 class="card-heading mt-4">Coupon code</h4>

                <input
                    class="form-control app-input"
                    type="text"
                    name="coupon"
                    placeholder="Enter coupon code">

                <h4 class="card-heading mt-4">Payment method</h4>

                <div class="payment-options">

                    <label class="payment-option">
                        <input type="radio" name="paymentMethod" value="COD" checked>
                        <span class="payment-radio-dot"></span>
                        <span class="payment-option-text">
                            <strong>Cash on delivery</strong>
                            <small>Pay when your order arrives</small>
                        </span>
                    </label>

                    <label class="payment-option">
                        <input type="radio" name="paymentMethod" value="Online">
                        <span class="payment-radio-dot"></span>
                        <span class="payment-option-text">
                            <strong>Online payment</strong>
                            <small>UPI, cards and net banking</small>
                        </span>
                    </label>

                </div>

                <button type="submit" class="btn btn-add-cart w-100 mt-4">
                    Place order
                </button>

            </form>

        </div>

    </div>

    <div class="col-lg-5">

        <div class="summary-card">

            <h5 class="summary-title">Order summary</h5>

            <% let subtotal = product.price; %>

            <div class="summary-item">

                <img
                    src="<%= product.imageURL %>"
                    class="summary-img"
                    alt="<%= product.title %>">

                <div class="summary-item-info">
                    <h6 class="summary-item-title"><%= product.title %></h6>
                    <p class="summary-item-qty">₹<%= product.price %> × 1</p>
                </div>

                <div class="summary-item-total">
                    ₹<%= product.price %>
                </div>

            </div>

            <hr>

            <div class="summary-line">
                <span>Subtotal</span>
                <span>₹<%= subtotal %></span>
            </div>

            <div class="summary-line text-muted">
                <span>Delivery</span>
                <span>Free</span>
            </div>

            <hr>

            <div class="summary-line summary-grand">
                <span>Total</span>
                <span>₹<%= product.price %></span>
            </div>

        </div>

    </div>

</div>

<style>

:root{
    --ink:#12131A;
    --paper:#FBFBFA;
    --accent:#3B49DF;
    --accent-ink:#2B36B0;
    --success:#0E8A6D;
    --danger:#D8394C;
    --muted:#6B7280;
    --line:#E6E6E9;
    --font-display:'Space Grotesk', sans-serif;
    --font-body:'Inter', sans-serif;
}

body{
    background:var(--paper);
    font-family:var(--font-body);
    color:var(--ink);
}

.section-title{
    font-family:var(--font-display);
    font-weight:700;
    font-size:1.6rem;
    margin:0;
}

.card-heading{
    font-family:var(--font-display);
    font-weight:700;
    font-size:1.05rem;
    margin-bottom:1rem;
}

/* Checkout card */
.checkout-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:16px;
    padding:1.5rem;
}

.app-input{
    border-radius:9px;
    border-color:var(--line);
    padding:.65rem .85rem;
    font-size:.92rem;
}

.app-input:focus{
    border-color:var(--accent);
    box-shadow:0 0 0 3px rgba(59,73,223,.15);
}

/* Payment options */
.payment-options{
    display:flex;
    flex-direction:column;
    gap:.75rem;
}

.payment-option{
    display:flex;
    align-items:center;
    gap:.85rem;
    border:1px solid var(--line);
    border-radius:12px;
    padding:.85rem 1rem;
    cursor:pointer;
    transition:.15s;
}

.payment-option:has(input:checked){
    border-color:var(--accent);
    background:#F5F6FE;
}

.payment-option input[type="radio"]{
    accent-color:var(--accent);
    width:18px;
    height:18px;
    flex-shrink:0;
    margin:0;
}

.payment-option-text{
    display:flex;
    flex-direction:column;
    line-height:1.3;
}

.payment-option-text strong{
    font-size:.92rem;
    font-weight:600;
}

.payment-option-text small{
    color:var(--muted);
    font-size:.8rem;
}

.btn-add-cart{
    background:var(--ink);
    color:#fff;
    border-radius:9px;
    font-weight:600;
    font-size:.95rem;
    border:none;
    padding:.75rem 1rem;
    transition:.2s;
}

.btn-add-cart:hover{
    background:var(--accent);
    color:#fff;
}

/* Summary card */
.summary-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:16px;
    padding:1.5rem;
    position:sticky;
    top:1rem;
}

.summary-title{
    font-family:var(--font-display);
    font-weight:700;
    margin-bottom:1rem;
}

.summary-item{
    display:flex;
    align-items:center;
    gap:.85rem;
    margin-bottom:1rem;
}

.summary-img{
    width:60px;
    height:60px;
    object-fit:cover;
    border-radius:10px;
    flex-shrink:0;
}

.summary-item-info{
    flex:1;
    min-width:0;
}

.summary-item-title{
    font-family:var(--font-display);
    font-size:.9rem;
    font-weight:600;
    margin-bottom:.15rem;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
}

.summary-item-qty{
    font-size:.8rem;
    color:var(--muted);
    margin:0;
}

.summary-item-total{
    font-family:var(--font-display);
    font-weight:600;
    font-size:.9rem;
    flex-shrink:0;
}

.summary-line{
    display:flex;
    justify-content:space-between;
    font-size:.95rem;
    margin-bottom:.6rem;
}

.summary-grand{
    font-family:var(--font-display);
    font-weight:700;
    font-size:1.15rem;
    color:var(--ink);
}

/* Responsive */
@media (max-width:991px){
    .summary-card{
        position:static;
    }
}

@media (max-width:576px){
    .checkout-card,
    .summary-card{
        padding:1.1rem;
    }
}

</style>

<%- include("./partials/footer") %>
