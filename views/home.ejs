<%- include("./partials/header") %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <% if(!search){ %>
        <!-- Hero -->
        <div class="hero rounded-4 p-4 p-md-5 mb-5">

            <div class="row align-items-center g-4">

                <div class="col-lg-6">

                    <span class="eyebrow">New season, curated</span>

                    <h1 class="hero-title">
                        Everything you need,<br>nothing you don't.
                    </h1>

                    <p class="hero-sub">
                        Electronics, fashion, footwear and accessories —
                        sourced, verified, and delivered fast.
                    </p>

                    <a href="#products" class="btn btn-hero mt-3">
                        Shop the collection
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </a>

                </div>

                <div class="col-lg-6 text-center">

                    <img src="https://images.unsplash.com/photo-1607082350899-7e105aa886ae?w=900"
                        class="img-fluid rounded-4 hero-img" alt="Featured products">

                </div>

            </div>

        </div>
        <% } %>
            <!-- Categories -->
            <% if(!search){ %>
                <div class="d-flex align-items-baseline justify-content-between mb-4">
                    <h2 class="section-title">Shop by category</h2>
                </div>

                <div class="row mb-5 g-3">

                    <div class="col-6 col-md-3">

                        <a href="/category/Electronics" class="text-decoration-none">

                            <div class="category-card">
                                <div class="category-icon">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                                        <rect x="4" y="4" width="16" height="11" rx="1.5" stroke="currentColor"
                                            stroke-width="1.6" />
                                        <path d="M9 19h6M12 15v4" stroke="currentColor" stroke-width="1.6"
                                            stroke-linecap="round" />
                                    </svg>
                                </div>
                                <h5>Electronics</h5>
                            </div>

                        </a>

                    </div>

                    <div class="col-6 col-md-3">

                        <a href="/category/Fashion" class="text-decoration-none">

                            <div class="category-card">
                                <div class="category-icon">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                                        <path d="M8 4l4 2 4-2 3 3-2 2v11H7V9L5 7l3-3z" stroke="currentColor"
                                            stroke-width="1.6" stroke-linejoin="round" />
                                    </svg>
                                </div>
                                <h5>Fashion</h5>
                            </div>

                        </a>

                    </div>

                    <div class="col-6 col-md-3">

                        <a href="/category/Shoes" class="text-decoration-none">

                            <div class="category-card">
                                <div class="category-icon">
                                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                                        <path
                                            d="M3 16c0-2 1.5-3 3-3s2 .8 3.2.8c1.6 0 2-2.3 4-2.3 2.5 0 3.8 2.5 6.8 2.5v3.5c0 .6-.4 1-1 1H4c-.6 0-1-.4-1-1v-1.5z"
                                            stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                                    </svg>
                                </div>
                                <h5>Shoes</h5>
                            </div>

                        </a>

                    </div>

                    <div class="col-6 col-md-3">

                        <div class="category-card">
                            <div class="category-icon">
                                <svg width="26" height="26" viewBox="0 0 24 24" fill="none">
                                    <circle cx="12" cy="12" r="6" stroke="currentColor" stroke-width="1.6" />
                                    <path d="M12 9v3l2 1.5" stroke="currentColor" stroke-width="1.6"
                                        stroke-linecap="round" />
                                </svg>
                            </div>
                            <h5>Accessories</h5>
                        </div>

                    </div>

                </div>
                <% } %>
                    <!-- Offer Banner -->
                    <% if(!search){ %>
                        <div class="offer-banner rounded-4 mb-5">
                            <span class="offer-tag">Limited time</span>
                            <span class="offer-copy">Up to <strong>50% off</strong> on selected products this
                                week.</span>
                        </div>
                        <% } %>

                            <!-- Products header -->
                            <div class="d-flex align-items-baseline justify-content-between flex-wrap gap-2 mb-4 products-header">

                                <div>
                                    <h2 id="products" class="section-title">
                                        <% if(search){ %>
                                            Search results
                                            <% } else { %>
                                                Latest products
                                                <% } %>
                                    </h2>

                                    <% if(search){ %>
                                        <p class="results-meta mb-0">
                                            <%= products.length %> result<%= products.length===1 ? '' : 's' %>
                                                for “<span class="results-query"><%= search %></span>”
                                        </p>
                                        <% } %>
                                </div>

                                <% if(products.length> 0){ %>
                                    <div class="sort-control">
                                        <label for="sortSelect" class="sort-label">Sort by</label>
                                        <select id="sortSelect" class="form-select form-select-sm sort-select"
                                            onchange="if(this.value) window.location.href=this.value;">
                                            <option value="" <%=(typeof sort==='undefined' || !sort) ? 'selected' : ''
                                                %>>Featured</option>
                                            <option
                                                value="?<%= search ? 'q='+encodeURIComponent(search)+'&' : '' %>sort=price_asc"
                                                <%=(typeof sort!=='undefined' && sort==='price_asc' ) ? 'selected' : ''
                                                %>>
                                                Price: Low to high</option>
                                            <option
                                                value="?<%= search ? 'q='+encodeURIComponent(search)+'&' : '' %>sort=price_desc"
                                                <%=(typeof sort!=='undefined' && sort==='price_desc' ) ? 'selected' :
                                                    '' %>>Price: High to low</option>
                                        </select>
                                    </div>
                                    <% } %>

                            </div>

                            <!-- No results -->
                            <% if(search && products.length===0){ %>

                                <div class="empty-state mb-5">
                                    <div class="empty-icon">
                                        <svg width="30" height="30" viewBox="0 0 24 24" fill="none">
                                            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
                                            <path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.6"
                                                stroke-linecap="round" />
                                            <path d="M8.5 8.5l5 5m0-5l-5 5" stroke="currentColor" stroke-width="1.4"
                                                stroke-linecap="round" />
                                        </svg>
                                    </div>
                                    <h5 class="mb-1">No results for “<%= search %>”</h5>
                                    <p class="text-muted mb-3">
                                        Try checking your spelling, using fewer words, or browsing a category
                                        instead.
                                    </p>
                                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                                        <a href="/category/Electronics" class="chip-link">Electronics</a>
                                        <a href="/category/Fashion" class="chip-link">Fashion</a>
                                        <a href="/category/Shoes" class="chip-link">Shoes</a>
                                    </div>
                                    <a href="/" class="btn btn-add-cart mt-3">Back to home</a>
                                </div>

                                <% } else { %>

                                    <div class="row g-4">

                                        <% products.forEach(product=> { %>

                                            <div class="col-6 col-md-6 col-lg-3">

                                                <div class="product-card h-100">

                                                    <div class="product-img-wrap">
                                                        <img src="<%= product.imageURL %>" class="product-img"
                                                            alt="<%= product.title %>">
                                                    </div>

                                                    <div class="card-body d-flex flex-column">

                                                        <p class="product-category">
                                                            <%= product.category %>
                                                        </p>

                                                        <h5 class="product-title">
                                                            <%= product.title %>
                                                        </h5>

                                                        <div
                                                            class="d-flex align-items-center justify-content-between mt-2 mb-3">

                                                            <span class="product-price">₹<%= product.price %></span>

                                                            <span class="product-rating">
                                                                <svg width="14" height="14" viewBox="0 0 24 24"
                                                                    fill="currentColor">
                                                                    <path
                                                                        d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.7 7-6.3-4-6.3 4 1.7-7L2 9.2l7.1-.6L12 2z" />
                                                                </svg>
                                                                4.5
                                                            </span>

                                                        </div>

                                                        <div class="mt-auto d-flex flex-column gap-2">

                                                            <a href="/products/<%= product._id %>"
                                                                class="btn btn-outline-dark w-100">

                                                                View details

                                                            </a>

                                                            <form action="/cart/add/<%= product._id %>"
                                                                method="POST">

                                                                <button class="btn btn-add-cart w-100">

                                                                    Add to cart

                                                                </button>

                                                            </form>

                                                        </div>

                                                    </div>

                                                </div>

                                            </div>

                                            <% }) %>

                                    </div>

                                    <% } %>

                                        <!-- Why Choose Us -->
                                        <% if(!search){ %>
                                            <div class="row text-center mt-5 g-4">

                                                <div class="col-md-4">
                                                    <div class="feature-icon">
                                                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                                            <path d="M3 7h11v9H3z" stroke="currentColor"
                                                                stroke-width="1.6" />
                                                            <path d="M14 10h4l3 3v3h-7z" stroke="currentColor"
                                                                stroke-width="1.6" stroke-linejoin="round" />
                                                            <circle cx="7" cy="18" r="1.6" stroke="currentColor"
                                                                stroke-width="1.4" />
                                                            <circle cx="17" cy="18" r="1.6" stroke="currentColor"
                                                                stroke-width="1.4" />
                                                        </svg>
                                                    </div>
                                                    <h4>Fast delivery</h4>
                                                    <p class="text-muted">Free delivery on orders above ₹999.</p>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="feature-icon">
                                                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                                            <rect x="5" y="10" width="14" height="10" rx="1.5"
                                                                stroke="currentColor" stroke-width="1.6" />
                                                            <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor"
                                                                stroke-width="1.6" />
                                                        </svg>
                                                    </div>
                                                    <h4>Secure payments</h4>
                                                    <p class="text-muted">100% secure online payments.</p>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="feature-icon">
                                                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                                                            <path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6l7-3z"
                                                                stroke="currentColor" stroke-width="1.6"
                                                                stroke-linejoin="round" />
                                                            <path d="M9 12l2 2 4-4" stroke="currentColor"
                                                                stroke-width="1.6" stroke-linecap="round"
                                                                stroke-linejoin="round" />
                                                        </svg>
                                                    </div>
                                                    <h4>Quality products</h4>
                                                    <p class="text-muted">Only genuine and verified products.</p>
                                                </div>

                                            </div>
                                            <% } %>

                                                <!-- Footer -->

                                                <hr class="mt-5">

                                                <footer class="text-center py-4">

                                                    <h4 class="footer-brand">ShopSphere</h4>

                                                    <p class="text-muted">Your one stop shopping destination</p>

                                                    <p class="text-muted small">© 2026 ShopSphere. All rights
                                                        reserved.</p>

                                                </footer>

                                                <style>
                                                    :root {
                                                        --ink: #12131A;
                                                        --paper: #FBFBFA;
                                                        --accent: #3B49DF;
                                                        --accent-ink: #2B36B0;
                                                        --success: #0E8A6D;
                                                        --muted: #6B7280;
                                                        --line: #E6E6E9;
                                                        --font-display: 'Space Grotesk', sans-serif;
                                                        --font-body: 'Inter', sans-serif;
                                                    }

                                                    body {
                                                        background: var(--paper);
                                                        font-family: var(--font-body);
                                                        color: var(--ink);
                                                        overflow-x: hidden;
                                                    }

                                                    h1,
                                                    h2,
                                                    h3,
                                                    h4,
                                                    h5 {
                                                        font-family: var(--font-display);
                                                    }

                                                    img {
                                                        max-width: 100%;
                                                    }

                                                    /* Hero */
                                                    .hero {
                                                        background: var(--ink);
                                                        color: #fff;
                                                        position: relative;
                                                        overflow: hidden;
                                                    }

                                                    .eyebrow {
                                                        display: inline-block;
                                                        font-size: .8rem;
                                                        letter-spacing: .08em;
                                                        text-transform: uppercase;
                                                        color: #B7BCF7;
                                                        margin-bottom: .75rem;
                                                        font-weight: 600;
                                                    }

                                                    .hero-title {
                                                        font-weight: 700;
                                                        font-size: clamp(1.5rem, 4.5vw + 0.5rem, 2.6rem);
                                                        line-height: 1.18;
                                                        margin-bottom: 1rem;
                                                    }

                                                    .hero-sub {
                                                        color: #C7C9D6;
                                                        font-size: clamp(.9rem, 1vw + .7rem, 1.05rem);
                                                        max-width: 32rem;
                                                    }

                                                    .btn-hero {
                                                        background: var(--accent);
                                                        color: #fff;
                                                        font-weight: 600;
                                                        padding: .7rem 1.4rem;
                                                        border-radius: 10px;
                                                        display: inline-flex;
                                                        align-items: center;
                                                        gap: .5rem;
                                                        transition: .2s;
                                                        border: none;
                                                    }

                                                    .btn-hero:hover {
                                                        background: var(--accent-ink);
                                                        color: #fff;
                                                    }

                                                    .hero-img {
                                                        max-height: 340px;
                                                        width: 100%;
                                                        object-fit: cover;
                                                        filter: saturate(1.05);
                                                    }

                                                    /* Section titles */
                                                    .section-title {
                                                        font-weight: 700;
                                                        font-size: clamp(1.25rem, 1.5vw + 1rem, 1.6rem);
                                                        margin: 0;
                                                    }

                                                    .results-meta {
                                                        font-size: .9rem;
                                                        color: var(--muted);
                                                        margin-top: .2rem;
                                                        word-break: break-word;
                                                    }

                                                    .results-query {
                                                        color: var(--ink);
                                                        font-weight: 600;
                                                    }

                                                    /* Sort control */
                                                    .sort-control {
                                                        display: flex;
                                                        align-items: center;
                                                        gap: .5rem;
                                                    }

                                                    .sort-label {
                                                        font-size: .85rem;
                                                        color: var(--muted);
                                                        margin: 0;
                                                        white-space: nowrap;
                                                    }

                                                    .sort-select {
                                                        border-radius: 8px;
                                                        border-color: var(--line);
                                                        font-size: .85rem;
                                                        min-width: 170px;
                                                    }

                                                    .sort-select:focus {
                                                        border-color: var(--accent);
                                                        box-shadow: 0 0 0 3px rgba(59, 73, 223, .15);
                                                    }

                                                    /* Categories */
                                                    .category-card {
                                                        background: #fff;
                                                        border: 1px solid var(--line);
                                                        border-radius: 14px;
                                                        padding: 1.5rem 1rem;
                                                        text-align: center;
                                                        transition: .2s ease;
                                                        color: var(--ink);
                                                    }

                                                    .category-card:hover {
                                                        border-color: var(--accent);
                                                        transform: translateY(-3px);
                                                        box-shadow: 0 10px 24px rgba(59, 73, 223, .12);
                                                    }

                                                    .category-icon {
                                                        width: 52px;
                                                        height: 52px;
                                                        margin: 0 auto .75rem;
                                                        display: flex;
                                                        align-items: center;
                                                        justify-content: center;
                                                        border-radius: 50%;
                                                        background: #EEF0FD;
                                                        color: var(--accent);
                                                    }

                                                    .category-card h5 {
                                                        font-size: .95rem;
                                                        font-weight: 600;
                                                        margin: 0;
                                                    }

                                                    /* Offer banner */
                                                    .offer-banner {
                                                        background: #EEF0FD;
                                                        border: 1px solid #D7DBF9;
                                                        padding: 1.1rem 1.5rem;
                                                        display: flex;
                                                        align-items: center;
                                                        gap: .9rem;
                                                        flex-wrap: wrap;
                                                    }

                                                    .offer-tag {
                                                        background: var(--accent);
                                                        color: #fff;
                                                        font-size: .72rem;
                                                        font-weight: 700;
                                                        letter-spacing: .06em;
                                                        text-transform: uppercase;
                                                        padding: .3rem .6rem;
                                                        border-radius: 6px;
                                                        white-space: nowrap;
                                                    }

                                                    .offer-copy {
                                                        font-size: clamp(.9rem, 1vw + .7rem, 1.05rem);
                                                        color: var(--ink);
                                                    }

                                                    /* Product cards */
                                                    .product-card {
                                                        background: #fff;
                                                        border: 1px solid var(--line);
                                                        border-radius: 16px;
                                                        overflow: hidden;
                                                        transition: .25s ease;
                                                    }

                                                    .product-card:hover {
                                                        transform: translateY(-6px);
                                                        box-shadow: 0 18px 34px rgba(18, 19, 26, .10);
                                                        border-color: transparent;
                                                    }

                                                    .product-img-wrap {
                                                        height: 220px;
                                                        overflow: hidden;
                                                        background: #F3F3F5;
                                                    }

                                                    .product-img {
                                                        width: 100%;
                                                        height: 100%;
                                                        object-fit: cover;
                                                    }

                                                    .product-category {
                                                        text-transform: uppercase;
                                                        font-size: .7rem;
                                                        letter-spacing: .06em;
                                                        color: var(--muted);
                                                        font-weight: 600;
                                                        margin-bottom: .2rem;
                                                    }

                                                    .product-title {
                                                        font-size: 1rem;
                                                        font-weight: 600;
                                                        margin-bottom: 0;
                                                    }

                                                    .product-price {
                                                        font-family: var(--font-display);
                                                        font-size: clamp(1rem, .6vw + .9rem, 1.2rem);
                                                        font-weight: 700;
                                                        color: var(--success);
                                                    }

                                                    .product-rating {
                                                        display: flex;
                                                        align-items: center;
                                                        gap: .3rem;
                                                        font-size: .85rem;
                                                        color: var(--muted);
                                                    }

                                                    .product-rating svg {
                                                        color: #F5A623;
                                                    }

                                                    .btn-outline-dark {
                                                        border-radius: 9px;
                                                        font-weight: 600;
                                                        font-size: .9rem;
                                                    }

                                                    .btn-add-cart {
                                                        background: var(--ink);
                                                        color: #fff;
                                                        border-radius: 9px;
                                                        font-weight: 600;
                                                        font-size: .9rem;
                                                        border: none;
                                                        transition: .2s;
                                                    }

                                                    .btn-add-cart:hover {
                                                        background: var(--accent);
                                                        color: #fff;
                                                    }

                                                    /* Feature icons */
                                                    .feature-icon {
                                                        width: 56px;
                                                        height: 56px;
                                                        margin: 0 auto 1rem;
                                                        display: flex;
                                                        align-items: center;
                                                        justify-content: center;
                                                        border-radius: 50%;
                                                        background: #EEF0FD;
                                                        color: var(--accent);
                                                    }

                                                    /* Empty state (search) */
                                                    .empty-state {
                                                        background: #fff;
                                                        border: 1px solid var(--line);
                                                        border-radius: 16px;
                                                        padding: 3.5rem 1.5rem;
                                                        text-align: center;
                                                    }

                                                    .empty-icon {
                                                        width: 64px;
                                                        height: 64px;
                                                        margin: 0 auto 1rem;
                                                        display: flex;
                                                        align-items: center;
                                                        justify-content: center;
                                                        border-radius: 50%;
                                                        background: #EEF0FD;
                                                        color: var(--accent);
                                                    }

                                                    .chip-link {
                                                        border: 1px solid var(--line);
                                                        border-radius: 20px;
                                                        padding: .4rem .9rem;
                                                        font-size: .85rem;
                                                        font-weight: 600;
                                                        color: var(--ink);
                                                        text-decoration: none;
                                                        transition: .15s;
                                                    }

                                                    .chip-link:hover {
                                                        border-color: var(--accent);
                                                        color: var(--accent);
                                                        background: #EEF0FD;
                                                    }

                                                    /* Footer */
                                                    .footer-brand {
                                                        font-weight: 700;
                                                        letter-spacing: -.01em;
                                                    }

                                                    /* ===== Responsive breakpoints ===== */

                                                    @media (max-width: 991px) {

                                                        .hero-img {
                                                            max-height: 260px;
                                                        }

                                                        .product-img-wrap {
                                                            height: 190px;
                                                        }
                                                    }

                                                    @media (max-width: 767px) {

                                                        .hero {
                                                            text-align: center;
                                                        }

                                                        .hero-sub {
                                                            max-width: 100%;
                                                            margin-inline: auto;
                                                        }

                                                        .btn-hero {
                                                            width: 100%;
                                                            justify-content: center;
                                                        }

                                                        .hero-img {
                                                            max-height: 220px;
                                                        }

                                                        .products-header {
                                                            align-items: stretch !important;
                                                        }

                                                        .sort-control {
                                                            width: 100%;
                                                            flex-wrap: wrap;
                                                        }

                                                        .sort-select {
                                                            min-width: 0;
                                                            flex: 1 1 auto;
                                                        }

                                                        .offer-banner {
                                                            flex-direction: column;
                                                            align-items: flex-start;
                                                            text-align: left;
                                                        }

                                                        .category-card {
                                                            padding: 1.1rem .75rem;
                                                        }

                                                        .category-icon {
                                                            width: 44px;
                                                            height: 44px;
                                                        }

                                                        .feature-icon {
                                                            width: 48px;
                                                            height: 48px;
                                                        }
                                                    }

                                                    @media (max-width: 576px) {

                                                        .hero {
                                                            padding: 1.75rem 1.25rem !important;
                                                        }

                                                        .product-img-wrap {
                                                            height: 140px;
                                                        }

                                                        .product-card .card-body {
                                                            padding: .75rem;
                                                        }

                                                        .product-title {
                                                            font-size: .9rem;
                                                        }

                                                        .empty-state {
                                                            padding: 2.5rem 1rem;
                                                        }
                                                    }
                                                </style>

                                                <%- include("./partials/footer") %>
