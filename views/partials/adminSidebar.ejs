<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

:root{
    --ink:#12131c;
    --ink-soft:#1b1d2b;
    --line-dark:rgba(255,255,255,.07);
    --accent:#6d5bd0;
    --accent-2:#f2a93b;
    --text-dim:#9296ab;
    --text-dim-2:#5d6072;
}

.ss-sidebar{
    position:fixed;
    left:0;
    top:0;
    width:264px;
    height:100vh;
    background:var(--ink);
    color:#fff;
    display:flex;
    flex-direction:column;
    z-index:1000;
    font-family:'Inter',sans-serif;
    border-right:1px solid var(--line-dark);
}

.ss-logo{
    display:flex;
    align-items:center;
    gap:12px;
    padding:24px 26px;
    border-bottom:1px solid var(--line-dark);
    flex-shrink:0;
}

.ss-orbit{
    position:relative;
    width:34px;
    height:34px;
    border-radius:50%;
    border:2px solid var(--accent);
    flex-shrink:0;
}

.ss-orbit::before{
    content:"";
    position:absolute;
    inset:0;
    margin:auto;
    width:10px;
    height:10px;
    border-radius:50%;
    background:var(--accent-2);
    top:-4px;
    left:14px;
    box-shadow:0 0 8px rgba(242,169,59,.7);
    animation:ss-spin 6s linear infinite;
    transform-origin:2px 21px;
}

@keyframes ss-spin{
    from{ transform:rotate(0deg) translate(0,0); }
    to{ transform:rotate(360deg) translate(0,0); }
}

.ss-wordmark{
    font-family:'Plus Jakarta Sans',sans-serif;
    font-size:19px;
    font-weight:700;
    letter-spacing:-.02em;
    white-space:nowrap;
}

.ss-wordmark em{
    font-style:normal;
    color:var(--accent-2);
}

.ss-nav{
    flex:1 1 auto;
    overflow-y:auto;
    padding:18px 14px;
}

.ss-nav::-webkit-scrollbar{ width:0; }

.ss-group-label{
    font-size:11px;
    font-weight:600;
    letter-spacing:.09em;
    color:var(--text-dim-2);
    text-transform:uppercase;
    padding:14px 12px 8px;
}

.ss-group-label:first-child{ padding-top:2px; }

.ss-nav a{
    position:relative;
    color:var(--text-dim);
    text-decoration:none;
    display:flex;
    align-items:center;
    gap:13px;
    padding:11px 14px;
    margin-bottom:2px;
    border-radius:10px;
    font-size:14.5px;
    font-weight:500;
    transition:background .18s ease, color .18s ease;
}

.ss-nav a i{
    font-size:17px;
    width:20px;
    text-align:center;
    flex-shrink:0;
}

.ss-nav a:hover{
    background:var(--ink-soft);
    color:#fff;
}

.ss-nav a.active{
    background:var(--ink-soft);
    color:#fff;
    font-weight:600;
}

.ss-nav a.active::before{
    content:"";
    position:absolute;
    left:-14px;
    top:50%;
    transform:translateY(-50%);
    width:4px;
    height:20px;
    border-radius:0 4px 4px 0;
    background:linear-gradient(180deg,var(--accent),var(--accent-2));
}

.ss-nav a.active i{
    color:var(--accent-2);
}

.ss-divider{
    height:1px;
    background:var(--line-dark);
    margin:12px 12px 14px;
    border:none;
}

.ss-bottom{
    flex-shrink:0;
    padding:14px;
    border-top:1px solid var(--line-dark);
}

.ss-bottom a{
    color:var(--text-dim);
    text-decoration:none;
    display:flex;
    align-items:center;
    gap:13px;
    padding:11px 14px;
    border-radius:10px;
    font-size:14.5px;
    font-weight:500;
    transition:background .18s ease, color .18s ease;
}

.ss-bottom a i{ font-size:17px; width:20px; text-align:center; }

.ss-bottom a:hover{ background:var(--ink-soft); color:#fff; }

.ss-bottom a.danger:hover{ background:rgba(220,38,38,.15); color:#f87171; }

@media(max-width:991px){

    .ss-sidebar{ width:76px; }

    .ss-logo{ padding:22px 0; justify-content:center; }

    .ss-wordmark{ display:none; }

    .ss-group-label{ display:none; }

    .ss-nav a, .ss-bottom a{ justify-content:center; padding:13px; }

    .ss-nav a span, .ss-bottom a span{ display:none; }

    .ss-nav a.active::before{ left:-8px; }

}

@media (prefers-reduced-motion: reduce){
    .ss-orbit::before{ animation:none; }
}

</style>

<div class="ss-sidebar">

    <div class="ss-logo">
        <div class="ss-orbit"></div>
        <div class="ss-wordmark">Shop<em>Sphere</em></div>
    </div>

    <nav class="ss-nav">

        <div class="ss-group-label">Overview</div>

        <a href="/admin/dashboard" class="<%= typeof active !== 'undefined' && active === 'dashboard' ? 'active' : '' %>">
            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>
        </a>

        <a href="/admin/analytics" class="<%= typeof active !== 'undefined' && active === 'analytics' ? 'active' : '' %>">
            <i class="bi bi-graph-up-arrow"></i>
            <span>Analytics</span>
        </a>

        <div class="ss-group-label">Catalog</div>

        <a href="/admin/products" class="<%= typeof active !== 'undefined' && active === 'products' ? 'active' : '' %>">
            <i class="bi bi-box-seam"></i>
            <span>Products</span>
        </a>

        <a href="/admin/product/add" class="<%= typeof active !== 'undefined' && active === 'add-product' ? 'active' : '' %>">
            <i class="bi bi-plus-circle"></i>
            <span>Add Product</span>
        </a>

        <a href="/admin/reviews" class="<%= typeof active !== 'undefined' && active === 'reviews' ? 'active' : '' %>">
            <i class="bi bi-star-half"></i>
            <span>Reviews</span>
        </a>

        <div class="ss-group-label">Sales &amp; People</div>

        <a href="/admin/orders" class="<%= typeof active !== 'undefined' && active === 'orders' ? 'active' : '' %>">
            <i class="bi bi-cart-check"></i>
            <span>Orders</span>
        </a>

        <a href="/admin/users" class="<%= typeof active !== 'undefined' && active === 'users' ? 'active' : '' %>">
            <i class="bi bi-people"></i>
            <span>Users</span>
        </a>

    </nav>

    <div class="ss-bottom">

        <a href="/admin/settings">
            <i class="bi bi-gear"></i>
            <span>Settings</span>
        </a>

        <a href="/user/logout" class="danger">
            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>
        </a>

    </div>

</div>
