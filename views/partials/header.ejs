<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopSphere</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --ink: #12131A;
            --paper: #FBFBFA;
            --accent: #3B49DF;
            --accent-ink: #2B36B0;
            --success: #0E8A6D;
            --muted: #6B7280;
            --line: #E6E6E9;
            --font-display: 'Space Grotesk', sans-serif;
            --font-body: 'Inter', sans-serif;
        }

        body {
            background: var(--paper);
            font-family: var(--font-body);
            color: var(--ink);
        }

        /* Navbar */
        .navbar-shop {
            background: var(--ink);
            padding: .7rem 0;
        }

        .navbar-shop .navbar-brand {
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.35rem;
            color: #fff;
            display: flex;
            align-items: center;
            gap: .5rem;
            letter-spacing: -.01em;
        }

        .navbar-shop .navbar-brand svg {
            color: #8F9AF7;
        }

        .navbar-shop .navbar-brand:hover {
            color: #fff;
        }

        /* Search */
        .search-form {
            position: relative;
            width: 38%;
        }

        .search-form input {
            background: #1E202B;
            border: 1px solid #2B2D3A;
            color: #fff;
            border-radius: 9px;
            padding: .5rem .9rem .5rem 2.3rem;
            font-size: .9rem;
        }

        .search-form input::placeholder {
            color: #8B8D9C;
        }

        .search-form input:focus {
            background: #1E202B;
            border-color: var(--accent);
            color: #fff;
            box-shadow: 0 0 0 3px rgba(59, 73, 223, .25);
        }

        .search-form svg {
            position: absolute;
            left: .75rem;
            top: 50%;
            transform: translateY(-50%);
            color: #8B8D9C;
            pointer-events: none;
        }

        .search-form .btn-search {
            display: none;
        }

        /* Nav links */
        .navbar-shop .nav-link {
            color: #D3D4DE;
            font-weight: 500;
            font-size: .92rem;
            padding: .5rem .9rem;
            border-radius: 8px;
            transition: .15s;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        .navbar-shop .nav-link:hover,
        .navbar-shop .nav-link:focus {
            color: #fff;
            background: rgba(255, 255, 255, .06);
        }

        .navbar-shop .dropdown-menu {
            border: none;
            border-radius: 12px;
            box-shadow: 0 16px 32px rgba(0, 0, 0, .18);
            padding: .4rem;
            margin-top: .5rem;
        }

        .navbar-shop .dropdown-item {
            border-radius: 8px;
            font-size: .9rem;
            padding: .5rem .75rem;
            font-weight: 500;
        }

        .navbar-shop .dropdown-item:hover {
            background: #EEF0FD;
            color: var(--accent-ink);
        }

        /* User pill */
        .user-pill {
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--accent);
            color: #fff;
            font-size: .75rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-display);
            flex-shrink: 0;
        }

        /* Cart link */
        .cart-link {
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: .1rem;
            right: .35rem;
            background: var(--accent);
            color: #fff;
            font-size: .62rem;
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 3px;
        }

        /* Auth buttons */
        .btn-nav-signup {
            background: var(--accent);
            color: #fff !important;
            border-radius: 8px;
            font-weight: 600 !important;
            margin-left: .25rem;
        }

        .btn-nav-signup:hover {
            background: var(--accent-ink);
            color: #fff !important;
        }

        @media (max-width:991px) {
            .search-form {
                width: 100%;
                margin: .75rem 0;
            }
        }
    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-shop sticky-top">

        <div class="container">

            <a class="navbar-brand" href="/">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path d="M3 4h2l1.5 11.5a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.3L20 8H6" stroke="currentColor"
                        stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="9" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="17" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6" />
                </svg>
                ShopSphere
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <!-- Search -->
                <form class="search-form mx-auto" action="/search" method="GET">

                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8" />
                        <path d="M21 21l-4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                    </svg>

                    <input class="form-control" type="search" name="q" placeholder="Search products">

                </form>

                <!-- Right Menu -->
                <ul class="navbar-nav ms-auto align-items-lg-center">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Home
                        </a>
                    </li>

                    <!-- Categories -->
                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">

                            Categories

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item" href="/category/Electronics">

                                    Electronics

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/category/Fashion">

                                    Fashion

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item" href="/category/Shoes">

                                    Shoes

                                </a>
                            </li>

                        </ul>

                    </li>
                    <% if(user){ %>

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle user-pill" data-bs-toggle="dropdown">

                                <span class="user-avatar">
                                    <%= user.name.charAt(0).toUpperCase() %>
                                </span>
                                <%= user.name %>

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>
                                    <a class="dropdown-item" href="/user/profile">

                                        Profile

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="/orders">

                                        My orders

                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" href="/user/logout">

                                        Logout

                                    </a>
                                </li>

                            </ul>

                        </li>

                        <% } else { %>

                            <li class="nav-item">
                                <a class="nav-link" href="/user/login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link btn-nav-signup" href="/user/signup">
                                    Signup
                                </a>
                            </li>

                            <% } %>

                                <li class="nav-item cart-link">
                                    <a class="nav-link" href="/cart">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                            <path
                                                d="M3 4h2l1.5 11.5a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.3L20 8H6"
                                                stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                                stroke-linejoin="round" />
                                            <circle cx="9" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6" />
                                            <circle cx="17" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6" />
                                        </svg>
                                        Cart
                                        <% if(typeof cartCount !=='undefined' && cartCount> 0){ %>
                                            <span class="cart-badge">
                                                <%= cartCount %>
                                            </span>
                                            <% } %>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="/wishlist">
                                        ❤️ Wishlist
                                    </a>
                                </li>

                </ul>

            </div>

        </div>

    </nav>

    <div class="container mt-4">