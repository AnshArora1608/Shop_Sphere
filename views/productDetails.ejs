<%- include("./partials/header") %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet">

<!-- Breadcrumb -->
<nav class="breadcrumb-nav mb-4">
    <a href="/">Home</a>
    <span class="crumb-sep">/</span>
    <a href="/category/<%= product.category %>"><%= product.category %></a>
    <span class="crumb-sep">/</span>
    <span class="crumb-current"><%= product.title %></span>
</nav>

<!-- Main product row -->
<div class="row g-5 mb-5">

    <div class="col-md-5">

        <div class="product-image-wrap">
            <img src="<%= product.imageURL %>" class="product-detail-img" alt="<%= product.title %>">
        </div>

    </div>

    <div class="col-md-7">

        <span class="badge-category"><%= product.category %></span>

        <h2 class="product-detail-title"><%= product.title %></h2>

        <div class="d-flex align-items-center gap-3 my-3">
            <span class="product-detail-price">₹<%= product.price %></span>

            <% if(product.stock > 0){ %>
                <span class="stock-badge stock-in">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    In stock · <%= product.stock %> left
                </span>
            <% } else { %>
                <span class="stock-badge stock-out">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    Out of stock
                </span>
            <% } %>
        </div>

        <hr>

        <h5 class="section-label">Description</h5>

        <p class="product-description"><%= product.description %></p>

        <div class="d-flex flex-wrap gap-2 mt-4">

            <form action="/cart/add/<%= product._id %>" method="POST" class="flex-grow-1">
                <button class="btn btn-add-cart-lg w-100" <%= product.stock <= 0 ? 'disabled' : '' %>>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 4h2l1.5 11.5a1.5 1.5 0 0 0 1.5 1.5h9a1.5 1.5 0 0 0 1.5-1.3L20 8H6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6"/><circle cx="17" cy="20" r="1.4" stroke="currentColor" stroke-width="1.6"/></svg>
                    Add to cart
                </button>
            </form>
<a href="/orders/buy-now/<%= product._id %>"
   class="btn btn-buy-now w-100 <%= product.stock <= 0 ? 'disabled' : '' %>"
   <%= product.stock <= 0 ? 'onclick="return false;"' : '' %>>
    Buy Now
</a>
            <form action="/wishlist/add/<%= product._id %>" method="POST">
                <button class="btn btn-wishlist" type="submit" aria-label="Add to wishlist">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none"><path d="M12 20s-7-4.35-9.5-8.5C.9 8.2 2.4 5 5.6 5c1.9 0 3.4 1.1 4.4 2.6C11 6.1 12.5 5 14.4 5c3.2 0 4.7 3.2 3.1 6.5C19 15.65 12 20 12 20z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                </button>
            </form>

        </div>

        <% if(product.stock <= 0){ %>
            <p class="stock-note mt-2">This item is currently unavailable — check back soon or explore similar products in <a href="/category/<%= product.category %>"><%= product.category %></a>.</p>
        <% } %>

    </div>

</div>

<!-- Reviews -->
<div class="section-block mb-5">

    <div class="d-flex align-items-baseline justify-content-between mb-3">
        <h4 class="section-title">Customer reviews</h4>
        <span class="review-count"><%= reviews.length %> review<%= reviews.length===1 ? '' : 's' %></span>
    </div>

    <% if(reviews.length===0){ %>

        <div class="empty-reviews">
            <p class="text-muted mb-0">No reviews yet — be the first to share your thoughts.</p>
        </div>

    <% } else { %>

        <div class="review-list">

            <% reviews.forEach(review=>{ %>

                <div class="review-card">

                    <div class="review-avatar"><%= review.user.name.charAt(0).toUpperCase() %></div>

                    <div class="review-content">

                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-1">
                            <span class="review-author"><%= review.user.name %></span>

                            <span class="review-stars">
                                <% for(let i=1; i<=5; i++){ %>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="<%= i <= review.rating ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="1.4"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.7 7-6.3-4-6.3 4 1.7-7L2 9.2l7.1-.6L12 2z"/></svg>
                                <% } %>
                            </span>
                        </div>

                        <p class="review-comment"><%= review.comment %></p>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>

<!-- Write a review -->
<div class="section-block mb-5">

    <h4 class="section-title mb-3">Write a review</h4>

    <div class="review-form-card">

        <form action="/review/<%= product._id %>" method="POST">

            <div class="mb-3">
                <label class="form-label-custom">Rating</label>
                <select class="form-select" name="rating">
                    <option value="5">★★★★★ — Excellent</option>
                    <option value="4">★★★★☆ — Good</option>
                    <option value="3">★★★☆☆ — Average</option>
                    <option value="2">★★☆☆☆ — Poor</option>
                    <option value="1">★☆☆☆☆ — Very poor</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Your review</label>
                <textarea
                    class="form-control"
                    rows="4"
                    name="comment"
                    required
                    placeholder="Share what you liked or didn't like about this product"></textarea>
            </div>

            <button class="btn btn-submit-review">Submit review</button>

        </form>

    </div>

</div>

<!-- Similar products -->
<% if(relatedProducts.length > 0){ %>

<div class="section-block mb-5">

    <h4 class="section-title mb-4">Similar products</h4>

    <div class="row g-4">

        <% relatedProducts.forEach(related=>{ %>

            <div class="col-lg-3 col-md-6">

                <div class="product-card h-100">

                    <div class="product-img-wrap">
                        <img src="<%= related.imageURL %>" class="product-img" alt="<%= related.title %>">
                    </div>

                    <div class="card-body d-flex flex-column">

                        <h5 class="product-title"><%= related.title %></h5>

                        <span class="product-price mt-2 mb-3">₹<%= related.price %></span>

                        <a href="/products/<%= related._id %>" class="btn btn-outline-dark w-100 mt-auto">
                            View
                        </a>

                    </div>

                </div>

            </div>

        <% }) %>

    </div>

</div>

<% } %>

<style>
    :root {
        --ink: #12131A;
        --paper: #FBFBFA;
        --accent: #3B49DF;
        --accent-ink: #2B36B0;
        --success: #0E8A6D;
        --danger: #D8394C;
        --muted: #6B7280;
        --line: #E6E6E9;
        --font-display: 'Space Grotesk', sans-serif;
        --font-body: 'Inter', sans-serif;
    }

    body {
        background: var(--paper);
        font-family: var(--font-body);
        color: var(--ink);
    }

    /* Breadcrumb */
    .breadcrumb-nav {
        font-size: .85rem;
        color: var(--muted);
    }

    .breadcrumb-nav a {
        color: var(--muted);
        text-decoration: none;
    }

    .breadcrumb-nav a:hover {
        color: var(--accent);
    }

    .crumb-sep {
        margin: 0 .4rem;
        color: var(--line);
    }

    .crumb-current {
        color: var(--ink);
        font-weight: 600;
    }

    /* Image */
    .product-image-wrap {
        border-radius: 18px;
        overflow: hidden;
        background: #F3F3F5;
        border: 1px solid var(--line);
    }

    .product-detail-img {
        height: 480px;
        width: 100%;
        object-fit: cover;
        display: block;
    }

    /* Badge / title */
    .badge-category {
        display: inline-block;
        background: #EEF0FD;
        color: var(--accent);
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        padding: .35rem .7rem;
        border-radius: 6px;
    }

    .product-detail-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.9rem;
        margin-top: .6rem;
    }

    .product-detail-price {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.9rem;
        color: var(--success);
    }

    /* Stock */
    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        font-size: .85rem;
        font-weight: 600;
        padding: .3rem .7rem;
        border-radius: 20px;
    }

    .stock-in {
        background: #E4F5EF;
        color: var(--success);
    }

    .stock-out {
        background: #FBE7E9;
        color: var(--danger);
    }

    .stock-note {
        font-size: .85rem;
        color: var(--muted);
    }

    .stock-note a {
        color: var(--accent);
        font-weight: 600;
    }

    /* Description */
    .section-label {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.05rem;
    }

    .product-description {
        color: var(--ink);
        line-height: 1.7;
        font-size: .98rem;
    }

    /* Buttons */
    .btn-add-cart-lg {
        background: var(--ink);
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
        padding: .75rem 1.2rem;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        transition: .2s;
    }

    .btn-add-cart-lg:hover:not(:disabled) {
        background: var(--accent);
        color: #fff;
    }

    .btn-add-cart-lg:disabled {
        background: #D9DAE0;
        color: #8A8C99;
        cursor: not-allowed;
    }

    .btn-buy-now {
        background: var(--accent);
        color: #fff;
        border-radius: 10px;
        font-weight: 600;
        padding: .75rem 1.2rem;
        border: none;
        transition: .2s;
    }

    .btn-buy-now:hover:not(:disabled) {
        background: var(--accent-ink);
        color: #fff;
    }

    .btn-buy-now:disabled {
        background: #D9DAE0;
        color: #8A8C99;
        cursor: not-allowed;
    }

    .btn-wishlist {
        width: 48px;
        height: 48px;
        flex: 0 0 auto;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--danger);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }

    .btn-wishlist:hover {
        background: var(--danger);
        border-color: var(--danger);
        color: #fff;
    }

    /* Section headings */
    .section-title {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.4rem;
        margin: 0;
    }

    .section-block{
        border-top: 1px solid var(--line);
        padding-top: 2rem;
    }

    .review-count{
        font-size: .85rem;
        color: var(--muted);
    }

    /* Reviews */
    .empty-reviews{
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.5rem;
    }

    .review-list{
        display: flex;
        flex-direction: column;
        gap: .9rem;
    }

    .review-card{
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 1.1rem 1.25rem;
        display: flex;
        gap: .9rem;
    }

    .review-avatar{
        width: 38px;
        height: 38px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #EEF0FD;
        color: var(--accent);
        font-family: var(--font-display);
        font-weight: 700;
        font-size: .9rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .review-content{
        flex: 1;
        min-width: 0;
    }

    .review-author{
        font-weight: 600;
        font-size: .92rem;
    }

    .review-stars{
        display: flex;
        gap: .1rem;
        color: #F5A623;
    }

    .review-comment{
        font-size: .92rem;
        color: var(--ink);
        margin: .4rem 0 0;
        line-height: 1.6;
    }

    /* Review form */
    .review-form-card{
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.5rem;
        max-width: 640px;
    }

    .form-label-custom{
        font-size: .85rem;
        font-weight: 600;
        color: var(--ink);
        margin-bottom: .4rem;
        display: block;
    }

    .review-form-card .form-select,
    .review-form-card .form-control{
        border-radius: 9px;
        border-color: var(--line);
        font-size: .92rem;
    }

    .review-form-card .form-select:focus,
    .review-form-card .form-control:focus{
        border-color: var(--accent);
        box-shadow: 0 0 0 3px rgba(59,73,223,.15);
    }

    .btn-submit-review{
        background: var(--ink);
        color: #fff;
        border: none;
        border-radius: 9px;
        font-weight: 600;
        font-size: .9rem;
        padding: .65rem 1.4rem;
        transition: .2s;
    }

    .btn-submit-review:hover{
        background: var(--accent);
        color: #fff;
    }

    /* Related product cards */
    .product-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
        transition: .25s ease;
    }

    .product-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 34px rgba(18, 19, 26, .10);
        border-color: transparent;
    }

    .product-img-wrap {
        height: 220px;
        overflow: hidden;
        background: #F3F3F5;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .product-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 0;
    }

    .product-price {
        font-family: var(--font-display);
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--success);
    }

    .btn-outline-dark {
        border-radius: 9px;
        font-weight: 600;
        font-size: .9rem;
    }

    @media (max-width:768px) {
        .product-detail-img {
            height: 320px;
        }

        .product-detail-title,
        .product-detail-price {
            font-size: 1.5rem;
        }
    }
</style>

<%- include("./partials/footer") %>
