<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | ShopSphere</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>

    :root{
        --ink:#12131A;
        --paper:#FBFBFA;
        --accent:#3B49DF;
        --accent-hover:#2B36B0;
        --line:#E6E6E9;
        --muted:#6B7280;
        --font-display:'Space Grotesk',sans-serif;
        --font-body:'Inter',sans-serif;
    }

    body{
        background:linear-gradient(135deg,#EEF0FD,#FBFBFA);
        min-height:100vh;
        display:flex;
        align-items:center;
        justify-content:center;
        font-family:var(--font-body);
    }

    .login-card{
        width:100%;
        max-width:950px;
        background:white;
        border-radius:20px;
        overflow:hidden;
        box-shadow:0 20px 50px rgba(0,0,0,.12);
    }

    .left-side{
        background:#12131A;
        color:white;
        padding:60px;
        display:flex;
        flex-direction:column;
        justify-content:center;
    }

    .left-side h1{
        font-family:var(--font-display);
        font-size:42px;
        font-weight:700;
    }

    .left-side p{
        color:#C7C9D6;
        margin-top:15px;
        line-height:1.7;
    }

    .left-side img{
        margin-top:40px;
        width:100%;
        border-radius:15px;
    }

    .right-side{
        padding:60px;
    }

    .right-side h2{
        font-family:var(--font-display);
        font-weight:700;
        margin-bottom:10px;
    }

    .right-side p{
        color:var(--muted);
        margin-bottom:30px;
    }

    .form-control{
        height:52px;
        border-radius:12px;
        border:1px solid var(--line);
    }

    .form-control:focus{
        border-color:var(--accent);
        box-shadow:0 0 0 4px rgba(59,73,223,.15);
    }

    .btn-login{
        background:var(--accent);
        color:white;
        height:52px;
        border:none;
        border-radius:12px;
        font-weight:600;
        transition:.3s;
    }

    .btn-login:hover{
        background:var(--accent-hover);
        color:white;
    }

    .signup-link{
        text-align:center;
        margin-top:20px;
    }

    .signup-link a{
        text-decoration:none;
        color:var(--accent);
        font-weight:600;
    }

    @media(max-width:768px){

        .left-side{
            display:none;
        }

        .right-side{
            padding:35px;
        }

    }

    </style>

</head>

<body>

<div class="container">

<div class="login-card">

<div class="row g-0">

<div class="col-md-6 left-side">

<h1>Welcome Back 👋</h1>

<p>

Login to continue shopping with ShopSphere.
Discover premium products with fast delivery and secure payments.

</p>

<img src="https://images.unsplash.com/photo-1607082350899-7e105aa886ae?w=900" alt="Shopping">

</div>

<div class="col-md-6 right-side">

<h2>Login</h2>

<p>Enter your account details below.</p>

<form action="/user/login" method="POST">

<div class="mb-3">

<label class="form-label">Email Address</label>

<input
type="email"
name="email"
class="form-control"
placeholder="Enter your email"
required>

</div>

<div class="mb-4">

<label class="form-label">Password</label>

<input
type="password"
name="password"
class="form-control"
placeholder="Enter your password"
required>

</div>

<button class="btn btn-login w-100">

Login

</button>

</form>

<div class="signup-link">

Don't have an account?

<a href="/user/signup">

Create Account

</a>

</div>

</div>

</div>

</div>

</div>

</body>

</html>
