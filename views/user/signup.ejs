<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | ShopSphere</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>

    :root{
        --ink:#12131A;
        --paper:#FBFBFA;
        --accent:#3B49DF;
        --accent-hover:#2B36B0;
        --line:#E6E6E9;
        --muted:#6B7280;
        --font-display:'Space Grotesk',sans-serif;
        --font-body:'Inter',sans-serif;
    }

    body{
        background:linear-gradient(135deg,#EEF0FD,#FBFBFA);
        min-height:100vh;
        display:flex;
        align-items:center;
        justify-content:center;
        font-family:var(--font-body);
    }

    .signup-card{
        width:100%;
        max-width:1000px;
        background:#fff;
        border-radius:20px;
        overflow:hidden;
        box-shadow:0 20px 50px rgba(0,0,0,.12);
    }

    .left-side{
        background:#12131A;
        color:#fff;
        padding:60px;
        display:flex;
        flex-direction:column;
        justify-content:center;
    }

    .left-side h1{
        font-family:var(--font-display);
        font-size:40px;
        font-weight:700;
    }

    .left-side p{
        margin-top:18px;
        color:#C7C9D6;
        line-height:1.7;
    }

    .left-side img{
        margin-top:35px;
        width:100%;
        border-radius:16px;
    }

    .right-side{
        padding:55px;
    }

    .right-side h2{
        font-family:var(--font-display);
        font-weight:700;
        margin-bottom:10px;
    }

    .right-side p{
        color:var(--muted);
        margin-bottom:30px;
    }

    .form-label{
        font-weight:600;
        margin-bottom:6px;
    }

    .form-control{
        height:52px;
        border-radius:12px;
        border:1px solid var(--line);
    }

    .form-control:focus{
        border-color:var(--accent);
        box-shadow:0 0 0 4px rgba(59,73,223,.15);
    }

    .btn-register{
        height:52px;
        border:none;
        border-radius:12px;
        background:var(--accent);
        color:#fff;
        font-weight:600;
        transition:.25s;
    }

    .btn-register:hover{
        background:var(--accent-hover);
        color:#fff;
    }

    .login-link{
        margin-top:20px;
        text-align:center;
    }

    .login-link a{
        text-decoration:none;
        color:var(--accent);
        font-weight:600;
    }

    @media(max-width:768px){

        .left-side{
            display:none;
        }

        .right-side{
            padding:35px;
        }

    }

    </style>

</head>

<body>

<div class="container">

<div class="signup-card">

<div class="row g-0">

<div class="col-md-6 left-side">

<h1>Create Account ✨</h1>

<p>

Join ShopSphere today and explore thousands of premium products,
exclusive deals, fast delivery and secure shopping.

</p>

<img src="https://images.unsplash.com/photo-1556740749-887f6717d7e4?w=900" alt="Shopping">

</div>

<div class="col-md-6 right-side">

<h2>Register</h2>

<p>Create your ShopSphere account.</p>

<form action="/user/signup" method="POST">

<div class="mb-3">

<label class="form-label">Full Name</label>

<input
type="text"
name="name"
class="form-control"
placeholder="Enter your name"
required>

</div>

<div class="mb-3">

<label class="form-label">Email Address</label>

<input
type="email"
name="email"
class="form-control"
placeholder="Enter your email"
required>

</div>

<div class="mb-4">

<label class="form-label">Password</label>

<input
type="password"
name="password"
class="form-control"
placeholder="Create a password"
required>

</div>

<button class="btn btn-register w-100">

Create Account

</button>

</form>

<div class="login-link">

Already have an account?

<a href="/user/login">

Login

</a>

</div>

</div>

</div>

</div>

</div>

</body>

</html>

